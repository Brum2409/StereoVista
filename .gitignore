# Do NOT ignore these important directories:
# !assets/
# !assets/shaders/
# !assets/models/
# !dependencies/
/.claude
StereoVista/imgui.ini
/StereoVista/x64
/StereoVista/x64/Debug
/StereoVista/x64
/StereoVista/x64
/kajiya-main
/OpenGL-VXGI-Engine-master
*.h5
/.kiro
/compute_rasterizer-master

# Vendored third-party binaries are dependencies (sources), not build
# outputs — re-include them against the bin/ x64/ *.exe rules above.
# (A parent dir must be un-ignored before files inside it can be.)
!dependencies/bin/
!dependencies/bin/**
!dependencies/lib/x64/
!dependencies/lib/x64/**
!dependencies/tools/
!dependencies/tools/**

# SLPK sample packages stay out of the repo — fetch/regenerate them per
# StereoVista/testdata/README.md (only the README + generators are tracked).
/StereoVista/testdata/*
!/StereoVista/testdata/README.md
!/StereoVista/testdata/make_synthetic_slpk.py
!/StereoVista/testdata/make_ktx2_testdata.py
!/StereoVista/testdata/make_lepcc_blobs.cpp

# Snapshot scene files written at runtime (UI redesign Pass 3)
snapshots/
StereoVista/snapshots/
