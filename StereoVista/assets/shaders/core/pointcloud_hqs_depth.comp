// pointcloud_hqs_depth.comp
// Schütz High-Quality Shading – PASS 1 of 3 (compute_loop_las_hqs/depth.cs).
//
// Finds the NEAREST surface depth per pixel.  Identical geometry handling to
// pointcloud_rasterize.comp (per-batch frustum cull, 10/20/30-bit precision
// LOD, local-space clip planes, adaptive round-splat) — the ONLY difference is
// the framebuffer write: instead of packing (depth|cloudID|index) into a 64-bit
// atomicMin, we atomicMin the LINEAR eye-space depth (clip.w) into a plain
// uint32 depth buffer.  The companion color pass (pointcloud_hqs_color.comp)
// then averages every point lying within a small relative depth window of this
// nearest depth, which is what removes the single-point aliasing / motion
// flicker of the standard "closest point wins" path.
//
// Depth is stored as floatBitsToUint(clip.w): clip.w is the positive linear eye
// distance for a perspective projection, so its IEEE-754 bit pattern is
// monotonic and atomicMin keeps the nearest point.  Sentinel 0xFFFFFFFF (larger
// than any finite positive-float bit pattern) = "no point".
//
// Decode / cull / precision-LOD code follows Schütz compute_loop_las (MIT);
// see pointcloud_rasterize.comp for the detailed commentary.

#version 460 core

#define STEPS_30BIT 1073741824  // 2^30
#define STEPS_10BIT 1024        // 2^10
#define MASK_10BIT  1023u       // 0x3FF

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

struct Batch {
    float min_x, min_y, min_z;
    float max_x, max_y, max_z;
    int   numPoints;
    int   firstPoint;
};

// Nearest linear-depth buffer (binding 2): one uint per pixel.
// coherent so the cheap non-atomic pre-read below stays fresh across the
// workgroup (same rationale as the standard rasterize framebuffer).
layout(std430, binding =  2) coherent buffer ssHqsDepthBlock { uint  ssDepth[];   };
layout(std430, binding = 40) readonly buffer ssBatchesBlock  { Batch ssBatches[]; };
layout(std430, binding = 41) readonly buffer ssXyz12bBlock   { uint  ssXyz_12b[]; };
layout(std430, binding = 42) readonly buffer ssXyz8bBlock    { uint  ssXyz_8b[];  };
layout(std430, binding = 43) readonly buffer ssXyz4bBlock    { uint  ssXyz_4b[];  };

uniform mat4  uMVP;             // proj * view * model
uniform mat4  uModelView;       // view * model  (precision level)
uniform mat4  uProj;            // projection    (precision level + splat scale)
uniform ivec2 uImageSize;
uniform int   uPointsPerThread;
uniform int   uSplatMaxRadius;  // 0 = single-pixel; >0 = max adaptive splat radius (px)

const int MAX_CLIP_PLANES = 6;
uniform int  uClipPlaneCount;
uniform vec4 uClipPlanes[MAX_CLIP_PLANES];

// ── Frustum culling (Gribb/Hartmann, adapted from Schütz / three.js, MIT) ─────
struct Plane { vec3 normal; float constant; };

float distanceToPoint(vec3 pt, Plane pl) { return dot(pl.normal, pt) + pl.constant; }

Plane createPlane(float x, float y, float z, float w) {
    float len = length(vec3(x, y, z));
    return Plane(vec3(x, y, z) / len, w / len);
}

bool intersectsFrustum(mat4 m, vec3 wgMin, vec3 wgMax) {
    float r0x = m[0][0], r0y = m[1][0], r0z = m[2][0], r0w = m[3][0];
    float r1x = m[0][1], r1y = m[1][1], r1z = m[2][1], r1w = m[3][1];
    float r2x = m[0][2], r2y = m[1][2], r2z = m[2][2], r2w = m[3][2];
    float r3x = m[0][3], r3y = m[1][3], r3z = m[2][3], r3w = m[3][3];

    Plane planes[6];
    planes[0] = createPlane(r3x - r0x, r3y - r0y, r3z - r0z, r3w - r0w); // right
    planes[1] = createPlane(r3x + r0x, r3y + r0y, r3z + r0z, r3w + r0w); // left
    planes[2] = createPlane(r3x + r1x, r3y + r1y, r3z + r1z, r3w + r1w); // bottom
    planes[3] = createPlane(r3x - r1x, r3y - r1y, r3z - r1z, r3w - r1w); // top
    planes[4] = createPlane(r3x - r2x, r3y - r2y, r3z - r2z, r3w - r2w); // near
    planes[5] = createPlane(r3x + r2x, r3y + r2y, r3z + r2z, r3w + r2w); // far

    for (int i = 0; i < 6; i++) {
        vec3 pv;
        pv.x = planes[i].normal.x > 0.0 ? wgMax.x : wgMin.x;
        pv.y = planes[i].normal.y > 0.0 ? wgMax.y : wgMin.y;
        pv.z = planes[i].normal.z > 0.0 ? wgMax.z : wgMin.z;
        if (distanceToPoint(pv, planes[i]) < 0.0) return false;
    }
    return true;
}

// ── Precision level (Schütz getPrecisionLevel, verbatim thresholds) ───────────
int getPrecisionLevel(vec3 wgMin, vec3 wgMax) {
    vec3  wgCenter = (wgMin + wgMax) * 0.5;
    float wgRadius = distance(wgMin, wgMax);

    vec4 viewCenter = uModelView * vec4(wgCenter, 1.0);
    vec4 viewEdge   = viewCenter + vec4(wgRadius, 0.0, 0.0, 0.0);
    vec4 projCenter = uProj * viewCenter;
    vec4 projEdge   = uProj * viewEdge;
    if (projCenter.w <= 0.0) return 0;

    projCenter.xy /= projCenter.w;
    projEdge.xy   /= projEdge.w;
    vec2 screenCenter = vec2(uImageSize) * (projCenter.xy * 0.5 + 0.5);
    vec2 screenEdge   = vec2(uImageSize) * (projEdge.xy   * 0.5 + 0.5);
    float pixelSize   = distance(screenEdge, screenCenter);

    if      (pixelSize <    100.0) return 4;
    else if (pixelSize <    200.0) return 3;
    else if (pixelSize <    500.0) return 2;
    else if (pixelSize < 10000.0)  return 1;
    else                           return 0;
}

float getBatchSpacing(vec3 boxSize, int numPoints) {
    if (numPoints <= 1) return 0.0;
    float d0 = max(boxSize.x, max(boxSize.y, boxSize.z));
    float d2 = min(boxSize.x, min(boxSize.y, boxSize.z));
    float d1 = (boxSize.x + boxSize.y + boxSize.z) - d0 - d2;
    float area = max(d0 * d1, 1e-12);
    return sqrt(area / float(numPoints));
}

// ── Nearest-depth write (atomicMin of linear eye depth) ───────────────────────
void writeDepth(ivec2 px, float linearDepth, int radius) {
    uint dz = floatBitsToUint(linearDepth);   // monotonic for positive depth
    if (radius <= 0) {
        ivec2 p = clamp(px, ivec2(0), uImageSize - ivec2(1));
        int idx = p.y * uImageSize.x + p.x;
        if (dz < ssDepth[idx]) atomicMin(ssDepth[idx], dz);  // early-z reject
        return;
    }
    int r2 = radius * radius;
    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            if (dx * dx + dy * dy > r2) continue;
            ivec2 p = px + ivec2(dx, dy);
            if (p.x < 0 || p.y < 0 || p.x >= uImageSize.x || p.y >= uImageSize.y) continue;
            int idx = p.y * uImageSize.x + p.x;
            if (dz < ssDepth[idx]) atomicMin(ssDepth[idx], dz);
        }
    }
}

void main() {
    uint  batchIndex = gl_WorkGroupID.x;
    Batch batch      = ssBatches[batchIndex];

    vec3 wgMin   = vec3(batch.min_x, batch.min_y, batch.min_z);
    vec3 wgMax   = vec3(batch.max_x, batch.max_y, batch.max_z);
    vec3 boxSize = wgMax - wgMin;

    if (!intersectsFrustum(uMVP, wgMin, wgMax)) return;

    int level = getPrecisionLevel(wgMin, wgMax);

    float splatScale = 0.0;
    if (uSplatMaxRadius > 0) {
        float worldSpacing = getBatchSpacing(boxSize, batch.numPoints);
        float modelScale   = length(vec3(uModelView[0]));
        float pxPerUnit    = uProj[1][1] * float(uImageSize.y) * 0.5;
        splatScale = 0.5 * worldSpacing * modelScale * pxPerUnit;
    }

    for (int i = 0; i < uPointsPerThread; i++) {
        uint localIndex = uint(i) * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
        if (int(localIndex) >= batch.numPoints) return;
        uint index = uint(batch.firstPoint) + localIndex;

        vec3 point;
        if (level == 0) {
            uint b4  = ssXyz_4b [index];
            uint b8  = ssXyz_8b [index];
            uint b12 = ssXyz_12b[index];
            uint X = (((b4 >> 0) & MASK_10BIT) << 20) | (((b8 >> 0) & MASK_10BIT) << 10) | ((b12 >> 0) & MASK_10BIT);
            uint Y = (((b4 >>10) & MASK_10BIT) << 20) | (((b8 >>10) & MASK_10BIT) << 10) | ((b12 >>10) & MASK_10BIT);
            uint Z = (((b4 >>20) & MASK_10BIT) << 20) | (((b8 >>20) & MASK_10BIT) << 10) | ((b12 >>20) & MASK_10BIT);
            point = vec3(float(X), float(Y), float(Z)) * (boxSize / float(STEPS_30BIT)) + wgMin;
        } else if (level == 1) {
            uint b4 = ssXyz_4b[index];
            uint b8 = ssXyz_8b[index];
            uint X = (((b4 >> 0) & MASK_10BIT) << 20) | (((b8 >> 0) & MASK_10BIT) << 10);
            uint Y = (((b4 >>10) & MASK_10BIT) << 20) | (((b8 >>10) & MASK_10BIT) << 10);
            uint Z = (((b4 >>20) & MASK_10BIT) << 20) | (((b8 >>20) & MASK_10BIT) << 10);
            point = vec3(float(X), float(Y), float(Z)) * (boxSize / float(STEPS_30BIT)) + wgMin;
        } else {
            uint b4 = ssXyz_4b[index];
            uint X = (b4 >> 0) & MASK_10BIT;
            uint Y = (b4 >>10) & MASK_10BIT;
            uint Z = (b4 >>20) & MASK_10BIT;
            point = vec3(float(X), float(Y), float(Z)) * (boxSize / float(STEPS_10BIT)) + wgMin;
        }

        bool clipped = false;
        for (int cp = 0; cp < uClipPlaneCount; ++cp) {
            if (dot(uClipPlanes[cp].xyz, point) + uClipPlanes[cp].w < 0.0) { clipped = true; break; }
        }
        if (clipped) continue;

        vec4 clip = uMVP * vec4(point, 1.0);
        if (clip.w <= 0.0) continue;
        vec3 ndc = clip.xyz / clip.w;
        if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0 || ndc.z < -1.0 || ndc.z > 1.0) continue;

        ivec2 px = ivec2((ndc.xy * 0.5 + 0.5) * vec2(uImageSize));

        int splatRadius = 0;
        if (uSplatMaxRadius > 0) splatRadius = clamp(int(splatScale / clip.w), 0, uSplatMaxRadius);

        // clip.w = positive linear eye depth → nearest-surface atomicMin.
        writeDepth(px, clip.w, splatRadius);
    }
}
