#version 460
// Schütz compute rasterizer — per-pixel colour lookup pass.
//
// Runs between the rasterize dispatches and the fragment resolve. For each
// pixel with a point, reads ssRGBA[index] once from the OWNING cloud and
// writes the packed colour to the separate colour buffer. The scatter runs in
// compute (1D workgroups, fully coalesced framebuffer traffic) because
// fragment-shader quads hide DRAM latency far worse — measured ~2 ms/eye
// slower in the GL app.
//
// ✎ Better than GL: the GL implementation dispatched this pass once PER
// CLOUD (re-reading the whole framebuffer each time) because it could only
// bind one rgba SSBO at a time. With buffer device addresses the packed
// cloudID simply indexes the frame's PointCloudDispatch array to fetch the
// owning cloud's rgba pointer — ONE dispatch per view resolves everything.

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require

#include "pointcloud_types.h"

layout(local_size_x = SV_PC_LOOKUP_WORKGROUP, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer PcFramebufferRO {
    uint64_t px[];
};
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer PcColorOut {
    uint v[];
};
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer PcRgba {
    uint v[];
};
layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer PcDispatchRef {
    PointCloudDispatch d;
};

layout(push_constant, scalar) uniform Push {
    PointCloudLookupPush pc;
};

void main() {
    int pixelID = int(gl_GlobalInvocationID.x);
    if (pixelID >= int(pc.pixelCount))
        return;

    uint64_t entry = PcFramebufferRO(pc.framebuffer).px[pixelID];

    // Sentinel = no point; the resolve discards the pixel, so the colour
    // buffer can stay stale.
    if (entry == 0xFFFFFFFFFFFFFFFFUL)
        return;

    // Entry layout: dist24 | cloudID:8 | index:32. cloudID is always in range
    // (PointCloudPass caps the frame at SV_PC_MAX_CLOUDS clouds).
    uint index = uint(entry & 0xFFFFFFFFUL);
    uint cloudID = uint((entry >> 32) & 0xFFUL);

    PcDispatchRef cloud =
        PcDispatchRef(pc.dispatchBase + uint64_t(cloudID) * uint64_t(pc.cloudStrideBytes));
    PcColorOut(pc.colorbuffer).v[pixelID] = PcRgba(cloud.d.rgba).v[index];
}
